<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">
    <data />
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="#F5F8FC">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="28dp">
            <ImageView android:layout_width="96dp" android:layout_height="96dp" android:src="@mipmap/ic_launcher" android:contentDescription="雅迪智行图标" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="雅迪智行" android:textSize="30sp" android:textStyle="bold" android:textColor="#20364B" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="选好地图，轻松规划每一程" android:gravity="center" android:textSize="15sp" android:textColor="#718398" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="32dp" android:padding="20dp" android:background="@drawable/entry_panel" android:text="地图选点 · 地点搜索 · 路线规划\n\n首次使用完成权限与地图配置后，下次将直接进入主界面。你随时可以在设置中切换地图。" android:textSize="14sp" android:textColor="#52677C" android:lineSpacingExtra="4dp" />
            <CheckBox android:id="@+id/privacy_consent" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:buttonTint="@color/master_color" android:text="我已阅读使用说明并同意所选地图服务的隐私政策" android:textSize="13sp" android:textColor="#52677C" android:minHeight="48dp" />
            <TextView android:id="@+id/privacy_links" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:gravity="center" android:textSize="13sp" android:textColor="@color/master_color" />
            <Button android:id="@+id/btn_go" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:background="@drawable/shape_round_30_color_master" android:backgroundTint="@color/master_color" android:text="@string/go_main" android:textColor="@color/white" android:textSize="16sp" android:textAllCaps="false" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="仅供开发与测试，请合理使用模拟定位" android:textSize="12sp" android:textColor="#94A1AF" android:gravity="center" />
        </LinearLayout>
    </ScrollView>
</layout>
