<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.appcompat.widget.Toolbar
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/master_color"
            app:title="模拟功能设置"
            app:titleTextColor="@color/white" />

        <Button android:id="@+id/btn_root_engine" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Root 模块状态与参数" />
        <Button android:id="@+id/btn_map_provider" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="切换百度 / 高德地图" />
        <Button android:id="@+id/btn_privacy_reset" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="撤回隐私同意并清除地点历史" />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </androidx.appcompat.widget.LinearLayoutCompat>
</layout>